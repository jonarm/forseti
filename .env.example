# Safe template: copy to ignored .env.local or use your hosting settings.
# Never commit real values. See docs/environment.md.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_DATABASE_HOST/YOUR_DATABASE
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional rate limiting; use your own Upstash account.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional social sign-in. Both values are required for each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional destructive retention job. Unset means refused, not publicly runnable.
CRON_SECRET=

# Retained integration; active application drafts do not require a model key.
ANTHROPIC_API_KEY=

# Optional demo data only. Leave disabled for independent, empty instances.
ALLOW_DEMO_SEED=0
DEMO_PASSWORD=

# For the disposable local Compose service ONLY, replace DATABASE_URL with:
# postgresql://forseti:forseti_local_dev@localhost:5432/forseti
